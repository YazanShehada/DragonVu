@{
    ViewData["Title"] = "AdminResetPassword";
}
<div class="d-flex justify-content-center align-items-center mt-5">
    <div class="card p-4" style=" max-width: 800px; width: 100%;">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show text-center mt-3" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show text-center mt-3" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <h2 class="mb-4 text-center">اعادة ضبط كلمة المرور</h2>
    
        <form asp-action="AdminResetPassword" method="post">
            <!-- إدخال UserId -->
            <div class="mb-3">
                <label class="form-label">أدخل معرف المستخدم</label>
                <input type="text" id="userName" name="userName" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">أدخل معرف المستخدم</label>
                <input type="text" id="newPassword" name="newPassword" class="form-control" required />
            </div>


            <button type="submit" class="btn btn-primary w-100">حفظ</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
   
}